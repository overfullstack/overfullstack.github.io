# Copy this file to .env and fill in your values.
# Astro exposes variables prefixed with PUBLIC_ to client-side code.

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
# Get yours at https://analytics.google.com
PUBLIC_GA_ID=G-9JBQXHVWQ5

# Firebase — used for the post Claps feature (Firestore)
# Get yours at https://console.firebase.google.com → Project settings → Web app config
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
